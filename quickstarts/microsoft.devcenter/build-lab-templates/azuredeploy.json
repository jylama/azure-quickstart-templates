
  {
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "userAssignedIdentityName": {
        "type": "string",
        "defaultValue": "myUserAssignedIdentity"
      },
      "keyVaultName": {
        "type": "string",
        "defaultValue": "myKeyVault"
      },
      "devCenterName": {
        "type": "string",
        "defaultValue": "myDevCenter"
      },
      "location": {
        "type": "string",
        "defaultValue": "[resourceGroup().location]"
      }
    },
    "variables": {
    },
    "resources": [
      {
        "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
        "apiVersion": "2023-07-31-preview",
        "name": "[parameters('userAssignedIdentityName')]",
        "location": "[parameters('location')]"
      },
      {
        "type": "Microsoft.KeyVault/vaults",
        "apiVersion": "2024-04-01-preview",
        "name": "[parameters('keyVaultName')]",
        "location": "[parameters('location')]",
        "dependsOn": [
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]"
        ],
        "properties": {
          "sku": {
            "family": "A",
            "name": "standard"
          },
          "tenantId": "[subscription().tenantId]",
          "enableRbacAuthorization": true
        },
        "resources": [
          {
            "type": "secrets",
            "apiVersion": "2024-04-01-preview",
            "name": "[parameters('secretName')]",
            "dependsOn": [
                    "[parameters('keyVaultName')]"
                ],
            "properties": {
              "value": "[parameters('secretValue')]"
            }
          }
        ]
      },
      {
        "type": "Microsoft.KeyVault/vaults/providers/roleAssignments",
        "apiVersion": "2022-04-01",
        "name": "[concat(parameters('keyVaultName'), '/Microsoft.Authorization/', guid(resourceGroup().id, parameters('keyVaultName'), parameters('userAssignedIdentityName'), 'keyVaultSecretUser'))]",
        "properties": {
            "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
            "principalId": "[reference(parameters('userAssignedIdentityName'), '2023-01-31').principalId]",
            "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
            "principalType": "ServicePrincipal"
        },
        "dependsOn": [
            "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
            "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]"
        ]
      },
      {
        "type": "Microsoft.DevCenter/devcenters",
        "apiVersion": "2024-10-01-preview",
        "name": "[parameters('devCenterName')]",
        "location": "[parameters('location')]",
        "dependsOn": [
            "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
            "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]"
        ],
        "identity": {
          "type": "UserAssigned",
          "userAssignedIdentities": {
            "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]": {}
          }
        },
        "properties": {
            "projectCatalogSettings": {
              "catalogItemSyncEnableStatus": "Enabled"
            },
            "networkSettings": {
              "microsoftHostedNetworkEnableStatus": "Enabled"
            },
            "devBoxProvisioningSettings": {
              "installAzureMonitorAgentEnableStatus": "Enabled"
            }
        },
        "resources": [
          {
              "type": "catalogs",
              "apiVersion": "2024-10-01-preview",
              "name": "quickstart-devbox-tasks",
              "dependsOn": [
                  "[parameters('devCenterName')]"
              ],
              "properties": {
                  "gitHub": {
                      "uri": "https://github.com/microsoft/devcenter-catalog.git",
                      "branch": "main",
                      "path": "Tasks"
                  }
              }
          }
        ]
      },
      {
        "type": "Microsoft.DevCenter/projects",
        "apiVersion": "2024-10-01-preview",
        "name": "[parameters('projectName')]",
        "location": "[parameters('location')]",
        "dependsOn": [
            "[resourceId('Microsoft.DevCenter/devcenters', parameters('devCenterName'))]"
        ],
        "identity": {
          "type": "UserAssigned",
          "userAssignedIdentities": {
            "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]": {}
          }
        },
        "properties": {
            "devCenterId": "[resourceId('Microsoft.DevCenter/devcenters', parameters('devCenterName'))]",
            "maxDevBoxesPerUser": 2,
            "catalogSettings": {
                "catalogItemSyncTypes": ["ImageDefinition"]
            }
        },
        "resources": [
           {
              "type": "catalogs",
              "apiVersion": "2024-10-01-preview",
              "name": "baseCatalog",
              "properties": {
                  "gitHub": {
                    "uri": "[parameters('catalogRepositoryUrl')]",
                    "branch": "ignite2024",
                    "path": ".devcenter/catalog/image-definitions/contoso-base",
                    "secretIdentifier": "[concat('https://', parameters('keyVaultName'), '.vault.azure.net/secrets/', parameters('secretName'))]"
                  },
                  "syncType": "Scheduled"
              },
              "dependsOn": [
                "[parameters('projectName')]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]"
              ]
          },
          {
              "type": "catalogs",
              "apiVersion": "2024-10-01-preview",
              "name": "[parameters('catalogName')]",
              "properties": {
                  "gitHub": {
                    "uri": "[parameters('catalogRepositoryUrl')]",
                    "branch": "ignite2024",
                    "path": ".devcenter/catalog/image-definitions/frontend",
                    "secretIdentifier": "[concat('https://', parameters('keyVaultName'), '.vault.azure.net/secrets/', parameters('secretName'))]"
                  },
                  "syncType": "Scheduled"
              },
              "dependsOn": [
                "[parameters('projectName')]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('userAssignedIdentityName'))]",
                "[resourceId('Microsoft.DevCenter/projects/catalogs', parameters('projectName'), 'baseCatalog')]"
              ]
          }
        ]
      },
      {
        "type": "Microsoft.Resources/deploymentScripts",
        "apiVersion": "2023-08-01",
        "name": "GetUserPrincipalIdScript",
        "location": "[parameters('location')]",
        "kind": "AzureCLI",
        "dependsOn": [
            "[resourceId('Microsoft.DevCenter/projects', parameters('projectName'))]"
        ],
        "properties": {
          "forceUpdateTag": "[parameters('currentTime')]",  // Ensures the script runs on every deployment
          "azCliVersion": "2.45.0",
          "scriptContent": "#!\/bin\/bash\r\nsleep 10",
          "timeout": "PT5M",
          "cleanupPreference": "Always",
          "retentionInterval": "P1D"
        }
      },
      {
        "type": "Microsoft.DevCenter/projects/pools",
        "apiVersion": "2024-10-01-preview",
        "name": "[concat(parameters('projectName'), '/CanadaCentralPool')]",
        "location": "[parameters('location')]",
        "dependsOn": [
            "[resourceId('Microsoft.Resources/deploymentScripts', 'GetUserPrincipalIdScript')]"
        ],
        "properties": {
            "devBoxDefinitionType": "Value",
            "devBoxDefinitionName": "[variables('devBoxDefinitionName')]",
            "devBoxDefinition": {
                "imageReference": {
                  "id": "[concat(resourceId('Microsoft.DevCenter/projects', parameters('projectName')), variables('devBoxDefinitionName'))]"
                },
                "sku": {
                    "name": "general_i_16c64gb2048ssd_v2"
                }
            },
            "networkConnectionName": "managedNetwork",
            "licenseType": "Windows_Client",
            "localAdministrator": "Enabled",
            "stopOnDisconnect": {
                "status": "Enabled",
                "gracePeriodMinutes": 60
            },
            "singleSignOnStatus": "Disabled",
            "virtualNetworkType": "Managed",
            "managedVirtualNetworkRegions": [
                "canadacentral"
            ]
        }
      },
      {
        "type": "Microsoft.DevCenter/projects/pools",
        "apiVersion": "2024-10-01-preview",
        "name": "[concat(parameters('projectName'), '/EuropePool')]",
        "location": "[parameters('location')]",
        "dependsOn": [
            "[resourceId('Microsoft.Resources/deploymentScripts', 'GetUserPrincipalIdScript')]"
        ],
        "properties": {
            "devBoxDefinitionType": "Value",
            "devBoxDefinitionName": "[variables('devBoxDefinitionName')]",
            "devBoxDefinition": {
                "imageReference": {
                  "id": "[concat(resourceId('Microsoft.DevCenter/projects', parameters('projectName')), variables('devBoxDefinitionName'))]"
                },
                "sku": {
                    "name": "general_i_16c64gb2048ssd_v2"
                }
            },
            "networkConnectionName": "managedNetwork",
            "licenseType": "Windows_Client",
            "localAdministrator": "Enabled",
            "stopOnDisconnect": {
                "status": "Enabled",
                "gracePeriodMinutes": 60
            },
            "singleSignOnStatus": "Disabled",
            "virtualNetworkType": "Managed",
            "managedVirtualNetworkRegions": [
                "switzerlandnorth"
            ]
        }
      },
      {
        "type": "Microsoft.DevCenter/projects/pools",
        "apiVersion": "2024-10-01-preview",
        "name": "[concat(parameters('projectName'), '/AsiaPool')]",
        "location": "[parameters('location')]",
        "dependsOn": [
            "[resourceId('Microsoft.Resources/deploymentScripts', 'GetUserPrincipalIdScript')]"
        ],
        "properties": {
            "devBoxDefinitionType": "Value",
            "devBoxDefinitionName": "[variables('devBoxDefinitionName')]",
            "devBoxDefinition": {
                "imageReference": {
                  "id": "[concat(resourceId('Microsoft.DevCenter/projects', parameters('projectName')), variables('devBoxDefinitionName'))]"
                },
                "sku": {
                    "name": "general_i_16c64gb2048ssd_v2"
                }
            },
            "networkConnectionName": "managedNetwork",
            "licenseType": "Windows_Client",
            "localAdministrator": "Enabled",
            "stopOnDisconnect": {
                "status": "Enabled",
                "gracePeriodMinutes": 60
            },
            "singleSignOnStatus": "Disabled",
            "virtualNetworkType": "Managed",
            "managedVirtualNetworkRegions": [
                "koreacentral"
            ]
        }
      },
      {
        "type": "Microsoft.DevCenter/projects/pools",
        "apiVersion": "2024-10-01-preview",
        "name": "[concat(parameters('projectName'), '/UsaPool')]",
        "location": "[parameters('location')]",
        "dependsOn": [
            "[resourceId('Microsoft.Resources/deploymentScripts', 'GetUserPrincipalIdScript')]"
        ],
        "properties": {
            "devBoxDefinitionType": "Value",
            "devBoxDefinitionName": "[variables('devBoxDefinitionName')]",
            "devBoxDefinition": {
                "imageReference": {
                  "id": "[concat(resourceId('Microsoft.DevCenter/projects', parameters('projectName')), variables('devBoxDefinitionName'))]"
                },
                "sku": {
                    "name": "general_i_16c64gb2048ssd_v2"
                }
            },
            "networkConnectionName": "managedNetwork",
            "licenseType": "Windows_Client",
            "localAdministrator": "Enabled",
            "stopOnDisconnect": {
                "status": "Enabled",
                "gracePeriodMinutes": 60
            },
            "singleSignOnStatus": "Disabled",
            "virtualNetworkType": "Managed",
            "managedVirtualNetworkRegions": [
                "centralus"
            ]
        }
      }
    ]
  }
